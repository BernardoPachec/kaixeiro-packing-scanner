{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "functions": {
    "api/ml-webhook.js": { "maxDuration": 30 },
    "api/questions.js": { "maxDuration": 60 },
    "api/full.js": { "maxDuration": 60 }
  }
}
